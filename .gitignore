# ignore everything in the root except the themes directory.
/*
!/wp-content/
/wp-content/*
!/wp-content/themes
!/wp-content/plugins
!/wp-content/mu-plugins

# ignore plugins
wp-content/plugins/*
wp-content/plugins/members

# ignore non-custom themes
wp-content/themes/*

# ignore node dependency directories
node_modules/

# ignore bootstrap files
wp-content/themes/melting_pot/bootstrap-4.5.0

# ignore log files and databases
*.log
*.sql
*.sqlite
.DS_Store

# don't ignore our theme
!wp-content/themes/melting_pot
!wp-content/themes/meltingpot-child

# don't ignore
!.gitignore
!README.md
!join
!members
!wp-content/plugins/challenge-score
!wp-content/plugins/facebook-group-secret
!wp-content/plugins/skill-competency-slider
!wp-content/plugins/player-profile
!wp-content/plugins/miniorange-firebase-authentication-enterprise
!wp-content/plugins/thepond-community

# Track only the customized BuddyBoss child, not the vendor parent/download extras.
!wp-content/themes/buddyboss-theme-child-1.0.0/
wp-content/themes/buddyboss-theme-child-1.0.0/*
!wp-content/themes/buddyboss-theme-child-1.0.0/functions.php
!wp-content/themes/buddyboss-theme-child-1.0.0/style.css
!wp-content/themes/buddyboss-theme-child-1.0.0/inc/
!wp-content/themes/buddyboss-theme-child-1.0.0/assets/
!wp-content/themes/buddyboss-theme-child-1.0.0/members-templates/
!wp-content/themes/buddyboss-theme-child-1.0.0/memberpress/
!wp-content/themes/buddyboss-theme-child-1.0.0/template-parts/
!wp-content/themes/buddyboss-theme-child-1.0.0/firebase-login.php
!wp-content/themes/buddyboss-theme-child-1.0.0/comments.php
!wp-content/themes/buddyboss-theme-child-1.0.0/challenges.php
!wp-content/themes/buddyboss-theme-child-1.0.0/routines.php
